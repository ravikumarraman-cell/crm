{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/calls/",
      "permanent": false
    },
    {
      "source": "/calls",
      "destination": "/calls/",
      "permanent": false
    },
    {
      "source": "/payments",
      "destination": "/payments/",
      "permanent": false
    },
    {
      "source": "/forms",
      "destination": "/forms/",
      "permanent": false
    }
  ]
}